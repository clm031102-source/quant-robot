      "factor_name": "swcp_cash_current_liability_improvement",
      "family": "statement_working_capital_pressure",
      "market": "CN",
      "asset_type": "stock",
      "registration_status": "pre_registered",
      "formula": "delta_4q(c_cash_equ_end_period / total_cur_liab), dated on the first valid trading date after ann_date",
      "hypothesis_source": "Round690/Round692 local PIT statement cache; cash-buffer and short-liability coverage fields not used by the failed timeliness or PEAD source-repair hypotheses.",
      "economic_rationale": "Improving cash coverage of current liabilities may reduce financing pressure and balance-sheet fragility after the report is observable.",
      "portfolio_backtest_allowed": false,
      "promotion_allowed": false
    },
    {
      "factor_name": "swcp_operating_working_capital_release",
      "family": "statement_working_capital_pressure",
      "market": "CN",
      "asset_type": "stock",
      "registration_status": "pre_registered",
      "formula": "-delta_4q((inventories + accounts_receiv - accounts_pay) / total_assets), dated on the first valid trading date after ann_date",
      "hypothesis_source": "PIT statement operating working-capital fields: inventories, receivables, payables, and total assets.",
      "economic_rationale": "Falling operating working-capital lockup can indicate cash release and lower financing demand, distinct from total accrual and profitability-revision signals.",
      "portfolio_backtest_allowed": false,
      "promotion_allowed": false
    },
    {
      "factor_name": "swcp_inventory_receivable_efficiency_improvement",
      "family": "statement_working_capital_pressure",
      "market": "CN",
      "asset_type": "stock",
      "registration_status": "pre_registered",
      "formula": "-delta_4q((inventories + accounts_receiv) / total_revenue), using revenue fallback only if total_revenue is absent",
      "hypothesis_source": "PIT statement inventory, receivable, and revenue fields with broad local coverage.",
      "economic_rationale": "Lower inventory and receivable intensity relative to revenue can proxy cleaner working-capital conversion and less cash trapped in operations.",
      "portfolio_backtest_allowed": false,
      "promotion_allowed": false
    },
    {
      "factor_name": "swcp_free_cashflow_liability_buffer",
      "family": "statement_working_capital_pressure",
      "market": "CN",
      "asset_type": "stock",
      "registration_status": "pre_registered",
      "formula": "free_cashflow / total_liab + c_cash_equ_end_period / total_cur_liab, dated on the first valid trading date after ann_date",
      "hypothesis_source": "PIT statement free-cashflow, cash, and liability fields.",
      "economic_rationale": "A stronger free-cashflow and cash buffer relative to liabilities may reduce near-term refinancing pressure after the statement is public.",
      "portfolio_backtest_allowed": false,
      "promotion_allowed": false
    },
    {
      "factor_name": "swcp_balanced_cash_working_capital_pressure",
      "family": "statement_working_capital_pressure",
      "market": "CN",
      "asset_type": "stock",
      "registration_status": "pre_registered",
      "formula": "frozen equal-weight same-date percentile-rank composite of cash-current-liability improvement, operating working-capital release, and free-cashflow liability buffer",
      "hypothesis_source": "Pre-registered composite of the Round693 operating working-capital pressure substructure; no optimized weights.",
      "economic_rationale": "Combining independent cash-buffer and working-capital-release measures can reduce single-field accounting noise while keeping the mechanism distinct from old profitability and accrual formulas.",
